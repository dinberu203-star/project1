{
  "dependencies": {
    "gh-pages": "^5.0.0",
    "lodash": "^4.17.21",
    "minimatch": "^9.0.3"
  },
  "scripts": {
    "dev": "parcel src/index.html",
    "build": "npx parcel build src/index.html --public-url /project1/",
    "build": "PARCEL_CACHE_DIR=/tmp/parcel-empty npx parcel build src/index.html --public-url /project1/ --no-cache",
  "lint": "npx eslint src/.",
    "lint": "npx eslint src/.",
    "test": "npx jest",
    "deploy": "npm run build && npx gh-pages -d dist",
    "ci": "npm run lint && npm run test && npm run deploy"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "parcel": "^2.16.4",
    "sass": "^1.101.0",
    "typescript-eslint": "^8.65.0"
  }
}